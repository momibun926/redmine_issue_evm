<% html_title("Project tracking with EVM - #{l(:label_nav_parent_issue)}") %>
<!-- sub title -->
<% content_for :title_sub do %>
  <%= l(:label_nav_parent_issue) %>
<% end %>
<%= render partial: "/common/evm_breakdown",
    locals: { cfg_param: @cfg_param,
              select_field: :selected_parent_issue_id,
              select_legend: l(:label_select_parent_issue),
              select_options: options_from_collection_for_select(@selectable_options, :id, :subject,
                                                                @cfg_param[:selected_parent_issue_id]),
              evm_data: @evm_data,
              chart_data_by_id: @evm_chart_data,
              chart_partial: "/common/basic_evm_chart_js",
              extra_chart_locals: {},
              heading_link_method: :parent_issue_link } %>
