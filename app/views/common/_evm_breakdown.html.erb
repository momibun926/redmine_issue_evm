<%#
  Shared body for the EVM "breakdown by X" pages (assignee / version / tracker /
  parent issue). Each dimension's own index.html.erb sets the page title and
  hands this partial the few things that actually differ between dimensions;
  everything else (the selection form, the "no data" message, and the
  per-selected-id EVM value table + chart) lives here once.

  Locals:
    cfg_param          - the shared view/EVM options hash (@cfg_param)
    select_field       - Symbol, the <select> field name / cfg_param key holding
                          the selected id(s)
    select_legend      - String, legend for the selection fieldset
    select_options     - String, pre-built <option> tags (options_for_select /
                          options_from_collection_for_select)
    evm_data           - Hash, id => CalculateEvm
    chart_data_by_id   - Hash, id => chart data for that CalculateEvm
    chart_partial      - String, partial to render the chart with
    extra_chart_locals - Hash, extra locals merged into the chart partial call
    heading_link_method - Symbol or nil; when present, a helper method(id) whose
                          (html-safe) result is shown before the EVM description
                          in the section heading (used by parent issues to link
                          to the issue)
%>
<!-- contextual -->
<%= render partial: "/common/contextual", locals: { project: @project, cfg_param: cfg_param, report_param: nil } %>
<!-- Content of view option -->
<% content_for :additional_option do %>
  <!-- selectable list -->
  <div class="evm-div-col">
    <fieldset><legend><%= select_legend %></legend>
      <%= select_tag select_field, select_options, { multiple: true, size: 5 } %>
    </fieldset>
  </div>
  <%= hidden_field_tag :no_use_baseline, cfg_param[:no_use_baseline] if cfg_param[:no_use_baseline].present? %>
  <%= hidden_field_tag :display_explanation, cfg_param[:display_explanation] if cfg_param[:display_explanation].present? %>
<% end %>
<!-- view option -->
<%= render partial: "/common/option_field" %>
<!-- contents -->
<section>
  <%= raw display_no_data(cfg_param[select_field]) %>
  <% evm_data.each do |id, evm| %>
    <h3>
      <% if heading_link_method %>
        <%= send(heading_link_method, id) %>
      <% end %>
      <%= evm.description %>
    </h3>
    <!-- EVM value -->
    <section>
      <h4><%= l(:subtitle_evm_indicator) %></h4>
      <%= render partial: "/common/basic_evm_value", locals: { evm: evm, cfg_param: cfg_param } %>
    </section>
    <br>
    <!-- Charts -->
    <section>
      <h4><%= l(:subtitle_evm_chart_main) %></h4>
      <%= render partial: chart_partial,
          locals: { basis_date: convert_to_labels(evm.finished_date || cfg_param[:basis_date]),
                    chart_data: chart_data_by_id[id],
                    basis_date_label: basis_date_label(evm.finished_date),
                    id: id,
                    tittle: evm.description }.merge(extra_chart_locals) %>
    </section>
  <% end %>
</section>
