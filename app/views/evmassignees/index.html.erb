<% html_title("Project tracking with EVM - #{l(:label_nav_assignee)}") %>
<!-- sub title -->
<% content_for :title_sub do %>
  <%= l(:label_nav_assignee) %>
<% end %>
<%= render partial: "/common/evm_breakdown",
    locals: { cfg_param: @cfg_param,
              select_field: :selected_assignee_id,
              select_legend: l(:label_select_assignee),
              select_options: options_for_select(@selectable_options, @cfg_param[:selected_assignee_id]),
              evm_data: @evm_data,
              chart_data_by_id: @evm_chart_data,
              chart_partial: "/evmassignees/assignee_evm_chart_js",
              extra_chart_locals: { working_hours: @cfg_param[:working_hours] },
              heading_link_method: nil } %>
