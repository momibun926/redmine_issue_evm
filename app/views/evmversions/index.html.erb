<% html_title("Project tracking with EVM - #{l(:label_nav_version)}") %>
<!-- sub title -->
<% content_for :title_sub do %>
  <%= l(:label_nav_version) %>
<% end %>
<%= render partial: "/common/evm_breakdown",
    locals: { cfg_param: @cfg_param,
              select_field: :selected_version_id,
              select_legend: l(:label_select_version),
              select_options: options_from_collection_for_select(@selectable_options, :fixed_version_id, :name,
                                                                @cfg_param[:selected_version_id]),
              evm_data: @evm_data,
              chart_data_by_id: @evm_chart_data,
              chart_partial: "/common/basic_evm_chart_js",
              extra_chart_locals: {},
              heading_link_method: nil } %>
